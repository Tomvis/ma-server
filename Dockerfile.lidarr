# Layer the rating-branch server + frontend + Lidarr plugin onto the upstream
# MA server image. Avoids a full venv rebuild (which currently needs an
# unreleased aiosendspin wheel). The upstream image's installed dependencies
# (aiosendspin, av, etc.) are kept; the music_assistant Python source is
# replaced wholesale with the rating-branch checkout, so server-side features
# like critical_reception filters and listen_later are present.
# Pin the base to the exact upstream tag the merged source sits on, rather than
# tracking `latest` or `nightly`, both of which move: the overlay replaces the
# music_assistant source wholesale, so a base that has drifted past the merged
# source ships a venv resolved for different pins than the code layered over it.
# 2.11 line: `enhanced` is merged to the 2.11.0.dev2026091803 tag exactly, so this
# base's venv matches the layered code pin-for-pin (aiosonos 0.1.13, models 1.1.212,
# frontend 2.17.312, aiosendspin still 9.1.1). Stopping at the tag rather than
# origin/dev HEAD is deliberate: only a tag has a published ghcr image to layer onto.
ARG UPSTREAM=ghcr.io/music-assistant/server:2.11.0.dev2026100503
FROM ${UPSTREAM}

# Replace upstream's installed music_assistant Python package with the
# rating-branch source. The first RM clears the existing site-packages
# directory so stale upstream files (e.g. removed providers, old controllers)
# don't shadow rating-branch code.
#
# BUT: 2.10 moved the bundled provider credentials out of app_vars.py (where
# 2.9.x obfuscated them into tracked source, so the overlay carried them) and
# into helpers/app_secrets.json, injected by upstream's build. That file is
# gitignored, so it can never be in the overlay - the rm below would delete it
# and app_var() would silently return "" for all ten providers that use it
# (tidal, spotify, apple_music, deezer, qobuz, lastfm x2, theaudiodb, fanarttv,
# acoustid_lookup). Stash it first and put it back afterwards.
RUN cp /app/venv/lib/python3.14/site-packages/music_assistant/helpers/app_secrets.json \
       /tmp/app_secrets.json
RUN rm -rf /app/venv/lib/python3.14/site-packages/music_assistant
COPY music_assistant_overlay/ \
     /app/venv/lib/python3.14/site-packages/music_assistant/
RUN mv /tmp/app_secrets.json \
       /app/venv/lib/python3.14/site-packages/music_assistant/helpers/app_secrets.json
# Fail the build rather than ship silently credential-less providers: an empty
# app_var only surfaces later as a confusing 400 from the provider's API.
RUN /app/venv/bin/python -c "\
import sys; \
from music_assistant.helpers.app_vars import app_var; \
missing = [n for n in ('tidal_client_id', 'spotify_client_id', 'theaudiodb_api_key') if not app_var(n)]; \
sys.exit('bundled app secrets missing: ' + repr(missing)) if missing else print('app secrets OK')"

# Replace upstream's installed music_assistant_models package with the
# rating-branch source — needed for the new dataclass fields like
# critical_reception, listen_later, etc.
RUN rm -rf /app/venv/lib/python3.14/site-packages/music_assistant_models
COPY models_overlay/ \
     /app/venv/lib/python3.14/site-packages/music_assistant_models/

# Pull in the rating-branch frontend (already-built static assets in the
# music_assistant_frontend Python package). Replaces the upstream-bundled
# frontend so Listen Later, Add to Lidarr, and other rating-branch UI changes
# are present in the deployed app.
COPY frontend_overlay/ \
     /app/venv/lib/python3.14/site-packages/music_assistant_frontend/

# Replace upstream's released aiosendspin with the enhanced-branch local-wheel
# build (9.1.1+trackfields = upstream 9.1.1 plus the trackfields split). The
# merged MA server pins aiosendspin[server]==9.1.1 (requirements_all.txt and
# providers/sendspin/manifest.json), which a PEP 440 public-version specifier
# matches regardless of the local label, and the trackfields shape (album_track /
# queue_track / total_tracks) is required by the enhanced sendspin/airplay/
# chromecast providers — without this overlay they fail on the metadata push.
# The version below is not free-form: scripts/staging cross-checks it against the
# wheel it stages and fails the build rather than ship a mislabelled dist-info.
RUN rm -rf /app/venv/lib/python3.14/site-packages/aiosendspin \
           /app/venv/lib/python3.14/site-packages/aiosendspin-*.dist-info
COPY aiosendspin_overlay/ \
     /app/venv/lib/python3.14/site-packages/aiosendspin/
COPY aiosendspin_dist_info_overlay/ \
     /app/venv/lib/python3.14/site-packages/aiosendspin-9.1.1+trackfields.dist-info/

# The 2.9.0/py3.14 base now ships everything the rating branch needs beyond
# the overlays: libportaudio2 plus the former pip deltas (torch/torchaudio
# 2.11.0+cpu, nnAudio, sounddevice, beat-this, einops, modern_colorthief) are
# all in the upstream venv, so no apt/pip layers are required anymore.

# Re-compile bytecode so module imports don't pay first-import cost on boot.
RUN /app/venv/bin/python -m compileall -q \
    /app/venv/lib/python3.14/site-packages/music_assistant \
    /app/venv/lib/python3.14/site-packages/music_assistant_models \
    /app/venv/lib/python3.14/site-packages/aiosendspin \
    || true
