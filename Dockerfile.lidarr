# Layer the rating-branch server + frontend + Lidarr plugin onto the upstream
# MA server image. Avoids a full venv rebuild (which currently needs an
# unreleased aiosendspin wheel). The upstream image's installed dependencies
# (aiosendspin, av, etc.) are kept; the music_assistant Python source is
# replaced wholesale with the rating-branch checkout, so server-side features
# like critical_reception filters and listen_later are present.
ARG UPSTREAM=ghcr.io/music-assistant/server:latest
FROM ${UPSTREAM}

# Replace upstream's installed music_assistant Python package with the
# rating-branch source. The first RM clears the existing site-packages
# directory so stale upstream files (e.g. removed providers, old controllers)
# don't shadow rating-branch code.
RUN rm -rf /app/venv/lib/python3.14/site-packages/music_assistant
COPY music_assistant_overlay/ \
     /app/venv/lib/python3.14/site-packages/music_assistant/

# Replace upstream's installed music_assistant_models package with the
# rating-branch source — needed for the new dataclass fields like
# critical_reception, listen_later, etc.
RUN rm -rf /app/venv/lib/python3.14/site-packages/music_assistant_models
COPY models_overlay/ \
     /app/venv/lib/python3.14/site-packages/music_assistant_models/

# Pull in the rating-branch frontend (already-built static assets in the
# music_assistant_frontend Python package). Replaces the upstream-bundled
# frontend so Listen Later, Add to Lidarr, and other rating-branch UI changes
# are present in the deployed app.
COPY frontend_overlay/ \
     /app/venv/lib/python3.14/site-packages/music_assistant_frontend/

# Replace upstream's released aiosendspin with the enhanced-branch local-wheel
# build (6.0.5+trackfields = upstream 6.0.5 plus the trackfields split). The
# merged MA server expects the aiosendspin 6.x API, and the trackfields shape
# (album_track / queue_track / total_tracks) is required by the enhanced
# sendspin/airplay/chromecast providers — without this overlay they fail to import.
RUN rm -rf /app/venv/lib/python3.14/site-packages/aiosendspin \
           /app/venv/lib/python3.14/site-packages/aiosendspin-*.dist-info
COPY aiosendspin_overlay/ \
     /app/venv/lib/python3.14/site-packages/aiosendspin/
COPY aiosendspin_dist_info_overlay/ \
     /app/venv/lib/python3.14/site-packages/aiosendspin-6.0.5+trackfields.dist-info/

# The 2.9.0/py3.14 base now ships everything the rating branch needs beyond
# the overlays: libportaudio2 plus the former pip deltas (torch/torchaudio
# 2.11.0+cpu, nnAudio, sounddevice, beat-this, einops, modern_colorthief) are
# all in the upstream venv, so no apt/pip layers are required anymore.

# Re-compile bytecode so module imports don't pay first-import cost on boot.
RUN /app/venv/bin/python -m compileall -q \
    /app/venv/lib/python3.14/site-packages/music_assistant \
    /app/venv/lib/python3.14/site-packages/music_assistant_models \
    /app/venv/lib/python3.14/site-packages/aiosendspin \
    || true
